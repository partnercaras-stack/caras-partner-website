{
  "name": "caras-partner-booking-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "Cal.eu booking webhook -> welcome email via Gmail, for Caras Partner",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --exec node server.js",
    "build:blog": "node scripts/build-blog.js",
    "build:pages": "node scripts/build-pages.js",
    "build:sitemap": "node scripts/build-sitemap.js",
    "sync:chrome": "node scripts/sync-chrome.js",
    "build": "npm run build:blog && npm run build:pages && npm run build:sitemap && npm run sync:chrome",
    "test:anthropic": "node scripts/test_anthropic_direct.js",
    "test:local": "node scripts/test_local_post.js"
  },
  "dependencies": {
    "nodemailer": "^6.9.14",
    "express": "^4.18.2",
    "node-fetch": "^2.6.12",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
