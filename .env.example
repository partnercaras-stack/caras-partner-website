# partner.caras@gmail.com gibi gönderici Gmail adresiniz
GMAIL_USER=partner.caras@gmail.com

# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama > Uygulama Şifreleri
# üzerinden oluşturulan 16 haneli "App Password" (normal Gmail şifreniz DEĞİL)
GMAIL_APP_PASSWORD=

# Cal.eu > Event Type > Webhooks bölümünde webhook oluştururken
# "Secret" alanına yazdığınız değerle BİREBİR AYNI olmalı
CAL_WEBHOOK_SECRET=

# Anthropic / Claude API key (konuşma asistanı için)
ANTHROPIC_API_KEY=

# Kullanılacak Claude modeli (isteğe bağlı)
CLAUDE_MODEL=claude-sonnet-5
